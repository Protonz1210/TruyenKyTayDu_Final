--- !u!114 &391539836
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 391539835}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0398308f5a5ed47f78e0ebdda227f87d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Map5StoryManager
  storyMode: 0
  dialogueController: {fileID: 831555558}
  duelTest: {fileID: 1501261055}
  sceneFadeController: {fileID: 831555559}
  buddhaInterventionController: {fileID: 0}
  introDialogueLines:
  - avatar: {fileID: -8568720582320623538, guid: 86e4397af82f3754da21ae5c04ffd2bb, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG"
    dialogueText: "Y\xEAu qu\xE1i, ng\u01B0\u01A1i theo ta \u0111\u1EBFn t\u1EADn
      d\u01B0\u1EDBi ch\xE2n Linh S\u01A1n, c\xF2n mu\u1ED1n gi\u1EA3 m\u1EA1o \u0111\u1EBFn
      bao gi\u1EDD?"
  - avatar: {fileID: 3657892570087867767, guid: 12560baa5179f5f48836564940ba433d, type: 3}
    speakerName: "L\u1EE4C NH\u0128 M\u1EF8 H\u1EA6U"
    dialogueText: "D\u01B0\u1EDBi tr\u1EDDi n\xE0y, ai m\u1EA1nh h\u01A1n th\xEC
      k\u1EBB \u0111\xF3 m\u1EDBi l\xE0 T\u1EC1 Thi\xEAn \u0110\u1EA1i Th\xE1nh th\u1EADt
      s\u1EF1."
  - avatar: {fileID: -4947449484447678323, guid: 12560baa5179f5f48836564940ba433d, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG"
    dialogueText: "V\u1EADy th\xEC \u1EDF \u0111\xE2y ph\xE2n th\u1EAFng b\u1EA1i
      tr\u01B0\u1EDBc, r\u1ED3i l\xEAn tr\u01B0\u1EDBc Ph\u1EADt T\u1ED5 ph\xE2n
      th\u1EADt gi\u1EA3."
  afterBeat1DialogueLines:
  - avatar: {fileID: -3665505726317585487, guid: 12560baa5179f5f48836564940ba433d, type: 3}
    speakerName: "L\u1EE4C NH\u0128 M\u1EF8 H\u1EA6U"
    dialogueText: "Th\u1EA5y ch\u01B0a? Ng\u01B0\u01A1i kh\xF4ng h\u01A1n ta ch\xFAt
      n\xE0o."
  - avatar: {fileID: -8568720582320623538, guid: 86e4397af82f3754da21ae5c04ffd2bb, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG"
    dialogueText: "Chi\xEAu th\u1EE9c gi\u1ED1ng ta, nh\u01B0ng t\xE2m t\xEDnh th\xEC
      kh\xF4ng th\u1EC3 gi\u1EA3 \u0111\u01B0\u1EE3c."
  - avatar: {fileID: 4103563852485784371, guid: 86e4397af82f3754da21ae5c04ffd2bb, type: 3}
    speakerName: "L\u1EE4C NH\u0128 M\u1EF8 H\u1EA6U"
    dialogueText: "V\u1EADy th\xEC l\xEAn thi\xEAn \u0111\xECnh, \u0111\u1EC3 Ph\u1EADt
      T\u1ED5 t\u1EF1 nh\xECn xem ai m\u1EDBi l\xE0 th\u1EADt."
  afterBeat2DialogueLines: []
  afterBeat3DialogueLines: []
  endDialogueLines: []
  nextSceneName: MAP 5.1
  delayBeforeLoadNextScene: 1
  useTransitionTextBeforeLoad: 1
  transitionTextToHeaven: "Linh S\u01A1n \u2013 Tr\u01B0\u1EDBc Ph\u1EADt T\u1ED5"
  useBuddhaIntervention: 1
  waitFadeInBeforeStartStory: 1
  startStoryDelay: 0.1
  useFinalEndingFade: 0
  delayBeforeFinalFade: 0.6
  finalEndingText: "H\xE0nh tr\xECnh th\u1EC9nh kinh v\u1EABn ti\u1EBFp t\u1EE5c..."
  keepBlackScreenAfterEnding: 1
  autoStartOnPlay: 1
  enableTestKey: 1
  isStoryRunning: 0
  isDuelBeatRunning: 0
  isBuddhaInterventionRunning: 0
  isEndingRunning: 0
  currentBeatIndex: 0
