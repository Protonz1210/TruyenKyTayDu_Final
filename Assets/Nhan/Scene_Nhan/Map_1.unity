--- !u!114 &731408467
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 731408466}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c25d1ce99bd36a04da27602518e76e4c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Map1GlobalDialogueController
  uiDocument: {fileID: 545515469}
  dialogueBoxName: dialogue-box
  avatarImageName: dialogue-avatar
  speakerNameTextName: dialogue-name
  dialogueTextName: dialogue-text
  nextHintTextName: dialogue-hint
  dialogueMode: 1
  nextKey: 19
  useKeyToNext: 1
  nextHint: E
  showHintInConversation: 1
  waitKeyReleaseBeforeConversationInput: 1
  dialogueLines:
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Aaaa y\xEAu qu\xE1i, y\xEAu qu\xE1i\u2026."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "Xin th\xED ch\u1EE7 \u0111\u1EEBng ho\u1EA3ng s\u1EE3, b\u1ECDn
      ta \u0111ang \u0111i c\u1EA7u kinh. \u0110i ngang qua qu\xFD trang, ch\u1EC9
      xin h\u1ECFi \u0111\u01B0\u1EDDng, kh\xF4ng d\xE1m l\xE0m phi\u1EC1n l\xE2u."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "\u0110i c\u1EA7u kinh \xE0, l\u1EA7n \u0111\u1EA7u ti\xEAn ta
      t\u1EEBng nghe th\u1EA5y."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "\u0110\xE2y l\xE0 \u0110\xE0 La Trang, kh\xF4ng bi\u1EBFt c\xE1c
      v\u1ECB tr\u01B0\u1EDFng l\xE3o t\xEDnh \u0111i c\u1EA7u kinh theo h\u01B0\u1EDBng
      n\xE0o \u0111\u1EC3 l\xE3o phu ti\u1EC7n ch\u1EC9 \u0111\u01B0\u1EDDng."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "T\xF4i \u0111ang mu\u1ED1n t\xECm \u0111\u01B0\u1EDDng sang T\xE2y
      Thi\xEAn th\u1EC9nh kinh."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Sang T\xE2y Thi\xEAn th\u1EC9nh kinh sao, th\u1EBF th\xEC t\xF4i
      khuy\xEAn th\u1EA7y tr\xF2 c\xE1c ng\u01B0\u1EDDi n\xEAn quay \u0111\u1EA7u
      v\u1EC1 \u0111i, ph\xEDa \u0111\xF3 s\u1EBD kh\xF4ng \u0111i \u0111\u01B0\u1EE3c
      n\u1EEFa \u0111\xE2u."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "\xDD c\u1EE7a L\xE3o N\xF4ng l\xE0 sao?"
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Ph\xEDa t\xE2y \u0110\xE0 La Trang n\xE0y, \u0111i h\u01A1n ba
      m\u01B0\u01A1i d\u1EB7m l\xE0 v\xF9ng Th\u1EA5t Tuy\u1EC7t S\u01A1n, trong
      n\xFAi c\xF3 m\u1ED9t \u0111\u01B0\u1EDDng \u0111i duy nh\u1EA5t g\u1ECDi l\xE0
      Hy Th\u1ECB \u0110\u1ED3ng. N\u01A1i \u1EA5y qu\u1EA3 h\u1ED3ng r\u1EE5ng xu\u1ED1ng,
      l\xE2u ng\xE0y th\u1ED1i r\u1EEFa, m\xF9i h\xF4i b\u1ED1c l\xEAn n\u1ED3ng
      n\u1EB7c, ng\u01B0\u1EDDi th\u01B0\u1EDDng \u0111i qua \u0111\xE3 kh\xF3 th\u1EDF."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "N\xF3i chung l\xE0 \u0111\u01B0\u1EDDng \u0111\xF3 kh\xF4ng \u0111i
      \u0111\u01B0\u1EE3c \u0111\xE2u, h\xE3y nghe t\xF4i \u1EDF \u0111\xE2y ngh\u1EC9
      ng\u01A1i h\u1ED3i s\u1EE9c r\u1ED3i quay \u0111\u1EA7u v\u1EC1 \u0111i."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "Ch\u1EC9 l\xE0 \u0111\u01B0\u1EDDng n\xFAi h\xF4i th\u1ED1i th\xEC
      c\xF3 g\xEC \u0111\xE1ng s\u1EE3?"
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Th\xFA th\u1EADt v\u1EDBi c\xE1c v\u1ECB, \u0111\xF3 l\xE0 c\xE1ch
      m\xE0 ng\u01B0\u1EDDi d\xE2n \u0110\xE0 La Trang ch\xFAng t\xF4i n\xF3i gi\u1EA3m
      n\xF3i tr\xE1nh \u0111\u1EC3 kh\xF4ng b\u1ECB n\xF3 nghe th\u1EA5y v\xE0 tr\u1EA3
      th\xF9."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Ch\u1EE9 th\u1EADt ra m\xF9i h\xF4i th\u1ED1i ph\xE1t ra l\xE0
      c\u1EE7a m\u1ED9t con y\xEAu qu\xE1i g\u1EA7n \u0111\xE2y, n\xF3 t\xEAn l\xE0
      H\u1ED3ng L\xE2n \u0110\u1EA1i M\xE3ng hay c\xF2n g\u1ECDi l\xE0 M\xE3ng X\xE0
      Tinh."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "H\u1ED3ng L\xE2n \u0110\u1EA1i M\xE3ng sao, n\xF3 l\xE0 con y\xEAu
      qu\xE1i nh\u01B0 n\xE0o?"
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "N\xF3 l\xE0 m\u1ED9t con M\xE3ng X\xE0 \u0111\xE3 th\xE0nh tinh,
      th\xE2n th\u1EC3 n\xF3 c\u1EF1c l\u1EDBn, v\u1EA3y \u0111\u1ECF nh\u01B0 m\xE1u
      kh\xF4. Khi tr\u01B0\u1EDDn qua khe n\xFAi, \u0111\xE1 v\u1EE5n c\u0169ng b\u1ECB
      nghi\u1EC1n n\xE1t."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "N\xF3 th\u01B0\u1EDDng \u1EA9n trong n\xFAi s\xE2u, khi c\xF3
      h\u01A1i ng\u01B0\u1EDDi l\u1EA1 \u0111i qua th\xEC b\u1EA5t ng\u1EDD lao ra.
      C\xE1i th\xE2n n\xF3 qu\u1EA5n m\u1ED9t v\xF2ng l\xE0 ng\u01B0\u1EDDi ng\u1EF1a
      g\xE3y x\u01B0\u01A1ng. C\xE1i mi\u1EC7ng n\xF3 h\xE1 ra, nu\u1ED1t ch\u1EEDng
      c\u1EA3 ng\u01B0\u1EDDi s\u1ED1ng."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "N\xF3 c\xF3 ba th\u1EE9 r\u1EA5t \u0111\xE1ng s\u1EE3."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Th\u1EE9 nh\u1EA5t l\xE0 th\xE2n r\u1EAFn kh\u1ED5ng l\u1ED3.
      N\xF3 qu\u1EADt \u0111u\xF4i m\u1ED9t c\xE1i, c\xE2y l\u1EDBn c\u0169ng g\xE3y,
      \u0111\xE1 n\xFAi v\u1EE1 tan."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Th\u1EE9 hai l\xE0 qu\u1EA5n si\u1EBFt. N\u1EBFu \u0111\u1EC3
      n\xF3 \xE1p s\xE1t, n\xF3 s\u1EBD d\xF9ng c\u1EA3 th\xE2n r\u1EAFn cu\u1ED1n
      l\u1EA5y ng\u01B0\u1EDDi. Ng\u01B0\u1EDDi b\u1ECB cu\u1ED1n r\u1ED3i th\xEC
      ch\u1EAFc ch\u1EAFn s\u1EBD kh\xF3 tho\xE1t."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "Th\u1EE9 ba l\xE0 m\xF9i tanh h\xF4i v\xE0 y\xEAu kh\xED trong
      n\xFAi. M\xF9i \u1EA5y l\u1EABn v\u1EDBi kh\xED th\u1ED1i c\u1EE7a Hy Th\u1ECB
      \u0110\u1ED3ng, khi\u1EBFn ng\u01B0\u1EDDi \u0111i qua cho\xE1ng v\xE1ng, tay
      ch\xE2n r\xE3 r\u1EDDi. C\xF3 ng\u01B0\u1EDDi ch\u01B0a k\u1ECBp th\u1EA5y
      y\xEAu qu\xE1i \u0111\xE3 ng\xE3 xu\u1ED1ng b\xEAn \u0111\u01B0\u1EDDng."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "T\xF4i e l\xE0 c\xE1c v\u1ECB \u0111\u1EBFn \u0111\xF3 kh\xF4ng
      nh\u1EEFng kh\xF4ng ch\u1ECBu \u0111\u01B0\u1EE3c l\xE2u m\xE0 c\xF2n l\xE0
      b\u1EEFa \u0103n th\u1ECBnh so\u1EA1n cho n\xF3."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "M\xE0 k\u1EC3 ra c\u0169ng l\u1EA1, t\u1EA1i sao t\u1EEB n\xE3y
      \u0111\u1EBFn gi\u1EDD t\xF4i ch\u01B0a th\u1EA5y ba ng\u01B0\u1EDDi kia n\xF3i
      n\u0103ng g\xEC v\u1EADy?"
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "\xC0, ch\u1EAFc do \u0111i \u0111\u01B0\u1EDDng xa, h\u1ECD th\u1EA5y
      m\u1EC7t n\xEAn h\u1ECD kh\xF4ng mu\u1ED1n n\xF3i chuy\u1EC7n th\xF4i."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "D\u1EABu sao th\xEC ch\xFAng t\xF4i v\u1EABn s\u1EBD \u0111i qua
      \u0111\xF3 \u0111\u1EC3 sang T\xE2y Thi\xEAn th\u1EC9nh kinh."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "C\u1EA3m \u01A1n th\xED ch\u1EE7 \u0111\xE3 ch\u1EC9 \u0111\u01B0\u1EDDng
      cho ch\xFAng t\xF4i."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "N\u1EBFu c\xE1c v\u1ECB \u0111\xE3 quy\u1EBFt nh\u01B0 v\u1EADy
      th\xEC e l\xE0 l\xE3o phu kh\xF4ng th\u1EC3 c\u1EA3n \u0111\u01B0\u1EE3c."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "T\xF4i nghe n\xF3i do th\xE2n h\xECnh to l\u1EDBn n\xEAn s\u1EE9c
      chi\u1EBFn \u0111\u1EA5u c\u1EE7a n\xF3 kh\xF4ng duy tr\xEC \u0111\u01B0\u1EE3c
      l\xE2u, t\xECm th\u1EDDi c\u01A1 h\u1EE3p l\xFD \u0111\u1EC3 t\u1EA5n c\xF4ng
      bi\u1EBFt \u0111\xE2u c\xF3 th\u1EC3 h\u1EA1 g\u1EE5c \u0111\u01B0\u1EE3c n\xF3."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "\u0110\u01B0\u1EE3c r\u1ED3i, gi\u1EDD t\xF4i ph\u1EA3i l\xEAn
      \u0111\u01B0\u1EDDng ngay \u0111\xE2y k\u1EBBo c\xF3 mu\u1ED9n."
  - avatar: {fileID: -8990452920826447450, guid: e9f70699f4a5d0c419bcc658d7483dbe, type: 3}
    speakerName: "L\xC3O N\xD4NG"
    dialogueText: "\u0110\u01B0\u1EDDng xa c\xF2n nhi\u1EC1u gian nan, nguy hi\u1EC3m.
      Chi b\u1EB1ng c\xE1c v\u1ECB h\xE3y n\xE1n l\u1EA1i d\xF9ng \xEDt c\u01A1m
      chay r\u1ED3i h\u1EB5ng l\xEAn \u0111\u01B0\u1EDDng."
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG?"
    dialogueText: "N\u1EBFu \u0111\u01B0\u1EE3c v\u1EADy th\xEC L\xE3o T\xF4n ta
      xin \u0111a t\u1EA1."
  dialogueTxtFile: {fileID: 4900000, guid: 24dae3c5ab04c4fa48f514d1bb48985f, type: 3}
  keepCurrentAvatarsWhenImport: 1
  maxWaitForUIDocumentReady: 2
  isDialoguePlaying: 0
  enableDebugLog: 0
