  freezePartyPhysicsDuringIntro: 1
  dialogueUIDocument: {fileID: 1291465987}
  dialogueBoxElementName: DialogueBox
  dialogueTextElementName: DialogueText
  dialogueHintElementName: DialogueHint
  useSkipKeyToNext: 1
  skipKey: 19
  nextHint: E
  dialogueLines:
  - text: "\u0110\u01AF\u1EDCNG XA M\u01AF\u1EDCI V\u1EA0N T\xC1M NG\xC0N,"
    voiceClip: {fileID: 8300000, guid: f109a6bb4ee902f42ac70d887117dacb, type: 3}
  - text: "TH\u1EA6Y TR\xD2 C\u1EA4T B\u01AF\u1EDAC MU\xD4N V\xC0N D\u1EB6M KH\u01A0I"
    voiceClip: {fileID: 8300000, guid: ef824c3f0109a494b9c9fddbc571f706, type: 3}
  - text: "C\xC0 SA NHU\u1ED8M N\u1EAENG S\u01AF\u01A0NG R\u01A0I,"
    voiceClip: {fileID: 8300000, guid: 0ac4e00b8e2963f4b8531095f07d78b6, type: 3}
  - text: "T\xC2M KINH M\u1ED8T D\u1EA2I S\xC1NG NG\u1EDCI L\xD2NG TA."
    voiceClip: {fileID: 8300000, guid: 1ef3d9c924ce09e4eb9df31de1c2c979, type: 3}
  - text: "G\u1EACY V\xC0NG QU\xC9T S\u1EA0CH Y\xCAU MA,"
    voiceClip: {fileID: 8300000, guid: 17a0d4a0b8ec52b4a8096629cdf64281, type: 3}
  - text: "B\xC1T GI\u1EDAI G\u1ED2NG G\xC1NH, SA H\xD2A T\u1EACN T\xC2M."
    voiceClip: {fileID: 8300000, guid: 46d2525cd1d7f5f48ad282fb05af5267, type: 3}
  - text: "NG\u1EF0A TR\u1EAENG NH\u1ECAP B\u01AF\u1EDAC TH\u0102NG TR\u1EA6M,"
    voiceClip: {fileID: 8300000, guid: 636329dadaf516a4fadd0c2cd10f3c2d, type: 3}
  - text: "V\u01AF\u1EE2T T\xC1M M\u1ED0T N\u1EA0N T\xCCM M\u1EA6M THI\u1EC6N DUY\xCAN."
    voiceClip: {fileID: 8300000, guid: 558862bbf2c3b8e4598e8f0ffc85a762, type: 3}
  - text: "LINH S\u01A0N B\u1EBEN \u0110\u1ED6 B\xCCNH Y\xCAN,"
    voiceClip: {fileID: 8300000, guid: 7cf472e8e0785b643879ba944abf21b1, type: 3}
  - text: "CH\xC2N KINH R\u1EA0NG R\u1EE0 KH\u1EAEP MI\u1EC0N NH\xC2N GIAN."
    voiceClip: {fileID: 8300000, guid: 62a1a2b870060584ebfbc374c34a05c5, type: 3}
  startTutorialAfterIntro: 1
  tutorialLines:
  - text: "Nh\u1EA5n A/D \u0111\u1EC3 di chuy\u1EC3n tr\xE1i/ph\u1EA3i"
    completeMode: 1
    requiredKeys: 0f00000012000000
    delayAfterComplete: 0.5
    waitWukongActionComplete: 1
    requireKeyReleaseBeforeNextBox: 1
    minWaitBeforeIdleCheck: 0.15
    maxWaitForLeaveIdleTime: 0.5
  - text: "Nh\u1EA5n Space \u0111\u1EC3 nh\u1EA3y/nh\u1EA3y cao(Double Jumb)"
    completeMode: 0
    requiredKeys: 01000000
    delayAfterComplete: 0.5
    waitWukongActionComplete: 1
    requireKeyReleaseBeforeNextBox: 1
    minWaitBeforeIdleCheck: 0.15
    maxWaitForLeaveIdleTime: 0.5
  - text: " Nh\u1EA5n J \u0111\u1EC3 \u0111\xE1nh th\u01B0\u1EDDng"
    completeMode: 0
    requiredKeys: 18000000
    delayAfterComplete: 0.5
    waitWukongActionComplete: 1
    requireKeyReleaseBeforeNextBox: 1
    minWaitBeforeIdleCheck: 0.15
    maxWaitForLeaveIdleTime: 0.5
  - text: " Nh\u1EA5n K \u0111\u1EC3 d\xF9ng chi\xEAu 1"
    completeMode: 0
    requiredKeys: 19000000
    delayAfterComplete: 0.5
    waitWukongActionComplete: 1
    requireKeyReleaseBeforeNextBox: 1
    minWaitBeforeIdleCheck: 0.15
    maxWaitForLeaveIdleTime: 0.5
  - text: " Nh\u1EA5n L \u0111\u1EC3 d\xF9ng chi\xEAu 2"
    completeMode: 0
    requiredKeys: 1a000000
    delayAfterComplete: 0.5
    waitWukongActionComplete: 1
    requireKeyReleaseBeforeNextBox: 1
    minWaitBeforeIdleCheck: 0.15
    maxWaitForLeaveIdleTime: 0.5
  - text: " Nh\u1EA5n I \u0111\u1EC3 d\xF9ng chi\xEAu 3"
    completeMode: 0
    requiredKeys: 17000000
    delayAfterComplete: 0.5
    waitWukongActionComplete: 1
    requireKeyReleaseBeforeNextBox: 1
    minWaitBeforeIdleCheck: 0.15
    maxWaitForLeaveIdleTime: 0.5
  - text: " Nh\u1EA5n Tab \u0111\u1EC3 t\u1EA1m d\u1EEBng "
    completeMode: 0
    requiredKeys: 03000000
    delayAfterComplete: 0.5
    waitWukongActionComplete: 1
    requireKeyReleaseBeforeNextBox: 1
    minWaitBeforeIdleCheck: 0.15
    maxWaitForLeaveIdleTime: 0.5
  waitWukongIdleBeforeNextTutorialBox: 1
  maxWaitForTutorialStepIdleTime: 5
  extraDelayAfterTutorialStepIdle: 0.15
  forceIdleIfTutorialStepTimeout: 0
  waitWukongIdleBeforeEndTutorial: 1
  maxWaitForTutorialEndIdleTime: 3
  extraDelayAfterTutorialIdle: 1
  startPostTutorialDialogueAfterTutorial: 1
  postTutorialDialogueLines:
  - text: "Kh\xF4ng ch\u1EADm tr\u1EC5 n\u1EEFa, gi\u1EDD th\xEC ta ph\u1EA3i nhanh
      ch\xE2n l\xEAn \u0111\u01B0\u1EDDng th\xF4i\u2026  "
  postTutorialDelayBetweenLines: 0.15
