  enemy4IntroLines:
  - avatar: {fileID: 4962213768438153873, guid: f600647f0442d8f45b4706ad6ba4dc53, type: 3}
    speakerName: "TI\u1EC2U TU\u1EA6N PHONG"
    dialogueText: "Ta \u0111\u01B0\u1EE3c \u0111ai v\u01B0\u01A1ng sai \u0111i tu\u1EA7n
      n\xFAi, tu\u1EA7n n\xFAi B\u1EAFc r\u1ED3i l\u1EA1i tu\u1EA7n n\xFAi Nam "
  - avatar: {fileID: 4962213768438153873, guid: f600647f0442d8f45b4706ad6ba4dc53, type: 3}
    speakerName: "TI\u1EC2U TU\u1EA6N PHONG"
    dialogueText: "N\xFAi c\u1EE7a ta c\xF3 t\xEAn l\xE0 S\u01B0 \u0110\xE0 L\u0129nh "
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG"
    dialogueText: "\u0110\xE8o m\u1EB9, Tu\u1EA7n n\xFAi c\xE1i con kh\u1EC9 nh\u1EADn
      m\u1ED9t g\u1EADy c\u1EE7a ta \u0111\xE2y"
  bossIntroLines:
  - avatar: {fileID: 4462887484362319747, guid: f8bb26988a850d44594c55eee215ce5c, type: 3}
    speakerName: "THANH S\u01AF TINH"
    dialogueText: "T\xEAn n\xE0o h\u1ED1ng h\xE1ch d\xE1m b\xE9n m\u1EA3ng \u0111\u1EBFn
      S\u01B0 \u0111\xE0 L\u0129nh c\u1EE7a ta "
  - avatar: {fileID: -120101713816299802, guid: d8f00bd141e29b34cb864d0c5979c463, type: 3}
    speakerName: "B\u1EA0CH T\u01AF\u1EE2NG TINH"
    dialogueText: "N\xF3 ch\xEDnh l\xE0 t\xEAn \u0111\xE3 \u0111\xE1nh ch\u1EBFt
      Ti\u1EC3u Tu\u1EA7n Phong \u1EDF d\u01B0\u1EDBi n\xFAi \u0111\xF3 \u0110\u1EA1i
      s\u01B0 huynh!!!"
  - avatar: {fileID: 4462887484362319747, guid: f8bb26988a850d44594c55eee215ce5c, type: 3}
    speakerName: "THANH S\u01AF TINH"
    dialogueText: "To gan \u0111\xE3 \u0111\u1EBFn \u0111\xE2y qu\u1EA5y r\u1ED1i
      l\u1EA1i l\xE0m ra chuy\u1EC7n t\xE0y \u0111\xECnh nh\u01B0  v\u1EADy"
  - avatar: {fileID: 4462887484362319747, guid: f8bb26988a850d44594c55eee215ce5c, type: 3}
    speakerName: "THANH S\u01AF TINH"
    dialogueText: "C\xE1c Con \u0111\xE2u l\xEAn \u0111\u1EADp ch\u1EBFt n\xF3 cho
      Ta "
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG"
    dialogueText: "C\xF3 bao nhi\xEAu l\xEAn h\u1EBFt \u0111\xE2y cho ta  "
  beforeBossFightLines:
  - avatar: {fileID: 4462887484362319747, guid: f8bb26988a850d44594c55eee215ce5c, type: 3}
    speakerName: "THANH S\u01AF TINH"
    dialogueText: "Nh\xE0 Ng\u01B0\u01A1i c\u0169ng kh\xE1 l\u1EAFm"
  - avatar: {fileID: 4462887484362319747, guid: f8bb26988a850d44594c55eee215ce5c, type: 3}
    speakerName: "THANH S\u01AF TINH"
    dialogueText: "Nh\u1ECB \u0110\u1EC7 \u0111\xE2u x\xF4ng l\xEAn"
  - avatar: {fileID: -120101713816299802, guid: d8f00bd141e29b34cb864d0c5979c463, type: 3}
    speakerName: "B\u1EA0CH T\u01AF\u1EE2NG TINH"
    dialogueText: "X\xF4ng l\xEAn!!!!"
  - avatar: {fileID: 4731215060098734805, guid: 286947317ff7ec0499aa2127adbc080c, type: 3}
    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG"
    dialogueText: "C\xF3 bao nhi\xEAu b\u01A1i h\u1EBFt v\xE0o \u0111\xE2y"
  boss5StoryLines:
  - avatar: {fileID: -7712416698979379300, guid: f5cbf63271fdbf647af482b15d094653, type: 3}
    speakerName: "KIM S\xCD \u0110I\u1EC2U"
    dialogueText: "M\u1ED9t con ti\u1EC3u y\xEAu gi\u1EA3 d\u1EA1ng th\xEC l\xE0m
      \u0111\u01B0\u1EE3c g\xEC cho \u0111\u1EDDi "
