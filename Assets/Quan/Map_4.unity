    speakerName: "T\xD4N NG\u1ED8 KH\xD4NG"
    dialogueText: Im ngayyyy!!!
  - avatar: {fileID: -7712416698979379300, guid: f5cbf63271fdbf647af482b15d094653, type: 3}
